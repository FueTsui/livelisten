<Project>
  <!-- Keep .NET build output under target\ next to the Rust output, so there is one ignored build folder. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\target\dotnet\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\target\dotnet\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
